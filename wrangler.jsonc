{
  // Cloudflare Workers config for Ajean Ledger (OpenNext adapter). See docs/HOSTING.md.
  // Free plan only. Testnet only. Secrets are NEVER put here: use `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ajean-ledger",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for internal fetches; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "ajean-ledger" }
  ],
  "observability": { "enabled": true },
  // Non-secret runtime config (process.env.* in the app). Override per deploy with
  // `wrangler deploy --var PAYMENT_MODE:testnet` or edit here.
  "vars": {
    "PAYMENT_MODE": "simulated",
    "X402_NETWORK": "eip155:84532",
    "X402_FACILITATOR_URL": "https://x402.org/facilitator",
    "STORE_KIND": "auto"
  }
  // Optional storage (free): uncomment after `npx wrangler kv namespace create AJEAN_KV`
  // and paste the id. Without it the app uses the in-memory store (+ replay fallback).
  // "kv_namespaces": [{ "binding": "AJEAN_KV", "id": "<KV_NAMESPACE_ID>" }]
}
