# Copy to .env.local and fill in. NEVER commit .env.local.
# TESTNET ONLY (Base Sepolia). Never put a mainnet key here.

# --- Payment ---
# testnet | simulated   (replay is a demo-console feature, not a server mode)
PAYMENT_MODE=simulated
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Service wallet that RECEIVES payments (address only, no key needed server-side)
SERVICE_PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Optional (credit packs, ADR-025): secret used to derive credit tokens (>= 16 chars). Unset = random per process.
# CREDIT_TOKEN_SECRET=

# --- Demo agent wallet (client side only: agent CLI / MCP bridge) ---
AGENT_PRIVATE_KEY=0x...
AGENT_MAX_PER_CALL_USDC=0.20
AGENT_DAILY_BUDGET_USDC=2.00
# MCP bridge: pay in USDC (default) or EURC; optional prepaid credit token tried before x402
# AJEAN_PAY_ASSET=USDC
# AJEAN_CREDIT_TOKEN=

# --- Optional LLM layer (engine works without it on structured inputs) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Service URL used by the agent / MCP bridge ---
AJEAN_LEDGER_URL=http://localhost:3000
