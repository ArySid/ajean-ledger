{
  "name": "ajean-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Accounting API for AI agents, paid per call in USDC via x402 (course PoC, testnet only).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "engine": "tsx scripts/engine-cli.ts",
    "pay:simulated": "tsx scripts/pay-simulated.ts",
    "pay:testnet": "tsx scripts/pay-testnet.ts",
    "smoke": "tsx scripts/smoke-api.ts",
    "mcp:stdio": "tsx mcp/server.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector tsx mcp/server.ts",
    "agent": "tsx agent/cli.ts",
    "record:replays": "tsx scripts/record-replays.ts",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "opennextjs-cloudflare preview --port 8787",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "node -e \"require('fs').mkdirSync('.wrangler/types',{recursive:true})\" && wrangler types --env-interface CloudflareEnv .wrangler/types/cloudflare-env.d.ts",
    "warmup": "tsx scripts/warmup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.2.1",
    "@upstash/redis": "^1.41.0",
    "@x402/core": "2.31.0",
    "@x402/evm": "2.31.0",
    "@x402/extensions": "2.31.0",
    "@x402/fetch": "2.31.0",
    "@x402/mcp": "2.31.0",
    "@x402/next": "2.31.0",
    "@x402/paywall": "2.31.0",
    "fast-xml-parser": "^5.12.1",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
